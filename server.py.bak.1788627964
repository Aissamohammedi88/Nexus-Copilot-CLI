#!/usr/bin/env python3
"""Nexus Blockchain OS — Serveur API correct."""
import http.server
import socketserver
import json
import hashlib
import time

PORT = 9004

class BlockchainOS:
    def __init__(self):
        self.chain = [self.genesis()]

    def genesis(self):
        return {
            "index": 0,
            "timestamp": time.time(),
            "data": "Genesis Nexus OS",
            "hash": hashlib.sha256("0".encode()).hexdigest()
        }

    def add_block(self, data):
        prev = self.chain[-1]
        block = {
            "index": len(self.chain),
            "timestamp": time.time(),
            "data": data,
            "prev_hash": prev["hash"],
        }
        block["hash"] = hashlib.sha256(json.dumps(block).encode()).hexdigest()
        self.chain.append(block)
        return block

    def verify(self):
        for i in range(1, len(self.chain)):
            if self.chain[i]["prev_hash"] != self.chain[i-1]["hash"]:
                return False
        return True

os_blockchain = BlockchainOS()

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html')
            self.end_headers()
            html = """
            <html><head><title>Nexus Blockchain OS</title></head>
            <body style="background:#0a0a0f;color:#00ff00;font-family:monospace;text-align:center;padding:50px">
            <h1>🔗 Nexus Blockchain OS</h1>
            <p>Serveur opérationnel sur le port 9004</p>
            <a href="/blocks">Voir les blocs</a>
            </body></html>
            """
            self.wfile.write(html.encode())
        elif self.path == '/blocks':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(os_blockchain.chain, indent=2).encode())
        else:
            self.send_response(404)
            self.end_headers()

if name == "__main__":
    print(f"Nexus Blockchain OS démarré sur http://localhost:{PORT}")
    socketserver.ThreadingTCPServer(("", PORT), Handler).serve_forever()
