[router]
strategy = "weighted"     # weighted | strict | consensus | fastest | cascade

[router.weights]
quality      = 0.45
cost         = 0.25
latency      = 0.15
privacy      = 0.10
availability = 0.05

[budget]
monthly_usd   = 50.00
per_request   = 0.10

[backends.local]
engine  = "vllm"
address = "http://localhost:8000"

[backends.cloud.openai]
enabled = false           # opt-in explicite
